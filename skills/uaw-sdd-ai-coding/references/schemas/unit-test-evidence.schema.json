{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaw.internal/sdd2/unit-test-evidence.schema.json",
  "title": "UAW-SDD 2.0 单元测试执行证据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "attempt",
    "scope_sha256",
    "scope_after_sha256",
    "scope_changed_during_test",
    "scope_violations",
    "code_revision",
    "runner_kind",
    "command",
    "cwd",
    "timeout_seconds",
    "started_at",
    "completed_at",
    "exit_code",
    "timed_out",
    "launch_error",
    "stdout_sha256",
    "stderr_sha256",
    "stdout_excerpt",
    "stderr_excerpt",
    "test_counts",
    "changed_test_paths",
    "changed_test_sources",
    "outcome",
    "failure_reason",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "feature_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_changed_during_test": {"type": "boolean"},
    "scope_violations": {"type": "array", "items": {"type": "string"}},
    "code_revision": {"type": "integer", "minimum": 1},
    "runner_kind": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "cwd": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "launch_error": {"type": ["string", "null"]},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_excerpt": {"type": "string"},
    "stderr_excerpt": {"type": "string"},
    "test_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "errors", "skipped", "source"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "changed_test_paths": {"type": "array", "items": {"type": "string"}},
    "changed_test_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{64}|<deleted>)$"
          }
        }
      }
    },
    "outcome": {"enum": ["passed", "failed", "blocked"]},
    "failure_reason": {"type": ["string", "null"]},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
