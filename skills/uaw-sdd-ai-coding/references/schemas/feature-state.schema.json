{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaw.internal/sdd2/feature-state.schema.json",
  "title": "UAW-SDD 2.0 Feature State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "feature_id",
    "feature_dir",
    "execution_mode",
    "entry_contract",
    "workspace_binding",
    "revision",
    "attempt",
    "current_stage",
    "stage_status",
    "artifacts",
    "approvals",
    "quality_gates",
    "phase_reviews",
    "next_required_action"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "feature_id": {"type": "string", "minLength": 1},
    "feature_dir": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["real", "demo", "historical-example"]},
    "entry_contract": {
      "type": "object",
      "required": ["user_entry", "developer_action_required", "version"],
      "properties": {
        "user_entry": {"const": "brief-prompt-and-skill-call"},
        "developer_action_required": {"const": false},
        "version": {"const": 1}
      }
    },
    "workspace_binding": {
      "type": "object",
      "required": ["repo_root", "worktree", "branch"]
    },
    "revision": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "current_stage": {
      "enum": ["brief-design", "proposal-input", "spec", "design", "tasks", "implementation", "code-review", "auto-fix", "unit-test-summary", "archive"]
    },
    "stage_status": {
      "enum": ["ready", "executing", "recorded", "awaiting-approval", "awaiting-final-approval", "blocked", "completed", "closed-with-risk", "aborted", "superseded"]
    },
    "artifacts": {"type": "object"},
    "approvals": {"type": "object"},
    "quality_gates": {"type": "object"},
    "phase_reviews": {"type": "object"},
    "next_required_action": {"type": "string", "minLength": 1}
  }
}
