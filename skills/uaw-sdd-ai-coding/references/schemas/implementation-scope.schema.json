{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaw.internal/sdd2/implementation-scope.schema.json",
  "title": "UAW-SDD 2.0 Implementation Scope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "feature_id", "attempt", "repo_root", "feature_repo_path",
    "branch", "base_commit", "allowed_paths", "forbidden_paths", "required_phases",
    "production_change", "test_path_patterns", "initial_snapshot", "code_revision"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "feature_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_phases": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "production_change": {"type": "boolean"},
    "test_path_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "code_revision": {"type": "integer", "minimum": 0},
    "initial_snapshot": {"$ref": "#/$defs/snapshot"},
    "frozen_snapshot": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["captured_at", "files", "head_commit", "head_tree", "snapshot_sha256", "violations"],
      "properties": {
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "minLength": 1}
            }
          }
        },
        "violations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
