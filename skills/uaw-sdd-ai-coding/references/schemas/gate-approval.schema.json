{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaw.internal/sdd2/gate-approval.schema.json",
  "title": "UAW-SDD 2.0 Gate 批准记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id", "timestamp", "feature_id", "attempt", "stage", "result",
    "source", "approver_role", "approval_text", "artifact_path",
    "artifact_revision", "artifact_sha256", "previous_hash", "record_hash"
  ],
  "properties": {
    "approval_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "feature_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["spec", "design", "tasks", "unit-test-summary", "archive"]},
    "result": {"const": "approved"},
    "source": {"enum": ["user-message", "demo-simulation"]},
    "approver_role": {"type": "string", "minLength": 1},
    "message_id": {"type": ["string", "null"]},
    "approval_text": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_revision": {"type": "integer", "minimum": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
